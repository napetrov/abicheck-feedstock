                })
    csv_path = out / "public_headers.csv.gz"
    with gzip.open(csv_path, "wt", encoding="utf-8", newline="") as f:
        w = csv.DictWriter(f, fieldnames=["path", "root", "size_bytes", "lines", "sha256"])
        w.writeheader(); w.writerows(sorted(rows, key=lambda x: x["path"]))
    summary = {
        "roots": [str(r.relative_to(src)) for r in roots],
        "files": len(rows), "lines": sum(r["lines"] for r in rows),
        "bytes": sum(r["size_bytes"] for r in rows), "inventory": csv_path.name,
        "top_level_headers": [str(p.relative_to(src)) for p in public_headers(target, src)],
    }
    write_json(out / "public_headers_summary.json", summary)
    return summary


def cmake_configure_build_install(
    target: str, src: Path, build: Path, install: Path, logs: Path,
    timings: list[CommandRecord], plugin_flags: str, env: dict[str, str], jobs: int,
) -> None:
    options = [
        "cmake", "-S", str(src), "-B", str(build), "-G", "Ninja",
        "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
        "-DCMAKE_C_COMPILER=clang", "-DCMAKE_CXX_COMPILER=clang++",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        f"-DCMAKE_INSTALL_PREFIX={install}",
        f"-DCMAKE_C_FLAGS={plugin_flags}",
        f"-DCMAKE_CXX_FLAGS={plugin_flags}",
    ]
    if target == "onetbb":
        options += ["-DTBB_TEST=OFF", "-DTBB_STRICT=OFF"]
    elif target == "onednn":
        options += [
            "-DDNNL_BUILD_TESTS=OFF", "-DDNNL_BUILD_EXAMPLES=OFF",
            "-DDNNL_CPU_RUNTIME=TBB", "-DDNNL_GPU_RUNTIME=NONE",
            "-DDNNL_ENABLE_GRAPH=ON", "-DDNNL_LIBRARY_TYPE=SHARED",
        ]
    elif target == "level-zero":
        options += ["-DBUILD_TESTS=OFF"]
    run_timed(name="cmake-configure", command=options, cwd=src, logs=logs, timings=timings, env=env, timeout=1800)
    run_timed(name="build", command=["cmake", "--build", str(build), "--parallel", str(jobs)], cwd=src, logs=logs, timings=timings, env=env, timeout=14400)
    run_timed(name="install", command=["cmake", "--install", str(build)], cwd=src, logs=logs, timings=timings, env=env, timeout=1800)


def setup_onedal_deps(work: Path, out: Path) -> tuple[dict[str, str], dict[str, Any]]:
    multiarch = simple_output(["gcc", "-print-multiarch"]).splitlines()[0].strip() or "x86_64-linux-gnu"
    deps = work / "deps"
    tbb = deps / "tbb"
    openblas = deps / "openblas"
    for p in (tbb / "include", tbb / "lib", openblas / "include", openblas / "lib"):
        p.mkdir(parents=True, exist_ok=True)
    for name in ("oneapi", "tbb"):
        source = Path("/usr/include") / name
        dest = tbb / "include" / name
        if source.exists() and not dest.exists():
            dest.symlink_to(source, target_is_directory=True)
    libdir = Path("/usr/lib") / multiarch
    for source in sorted(libdir.glob("libtbb*.so*")):
        dest = tbb / "lib" / source.name
        if not dest.exists():
            dest.symlink_to(source)
    for name in ("cblas.h", "f77blas.h", "openblas_config.h"):
        candidates = [Path("/usr/include") / name, Path("/usr/include") / multiarch / name]
        source = next((p for p in candidates if p.exists()), None)
        if source is not None:
            dest = openblas / "include" / name
            if not dest.exists():
                dest.symlink_to(source)
    libopenblas = next(iter(sorted(libdir.glob("libopenblas*.a"))), None)
    if libopenblas is None:
        raise HarnessError(f"no static OpenBLAS archive under {libdir}")
    (openblas / "lib" / "libopenblas.a").symlink_to(libopenblas)
    env_add = {
        "TBBROOT": str(tbb), "OPENBLASROOT": str(openblas),
        "LD_LIBRARY_PATH": str(tbb / "lib") + os.pathsep + os.environ.get("LD_LIBRARY_PATH", ""),
    }
    meta = {
        "multiarch": multiarch, "tbbroot": str(tbb), "openblasroot": str(openblas),
        "tbb_entries": [str(p) for p in sorted(tbb.rglob("*"))],
        "openblas_entries": [str(p) for p in sorted(openblas.rglob("*"))],
        "environment": env_add,
    }
    write_json(out / "onedal-dependencies.json", meta)
    return env_add, meta


def build_onedal(
    src: Path, build: Path, install: Path, work: Path, out: Path, logs: Path,
    timings: list[CommandRecord], plugin_flags: str, env: dict[str, str], jobs: int,
) -> None:
    compiler_file = src / "dev/make/compiler_definitions/clang.ref.32e.mk"
    original = compiler_file.read_text(encoding="utf-8")
    patched = original.replace(
        "COMPILER.mac.clang = $(COMPILER.mac.clang) -DDAAL_REF -DONEDAL_REF",
        "COMPILER.mac.clang += -DDAAL_REF -DONEDAL_REF",
    ).replace(
        "COMPILER.lnx.clang = $(COMPILER.lnx.clang) -DDAAL_REF -DONEDAL_REF",
        "COMPILER.lnx.clang += -DDAAL_REF -DONEDAL_REF",
    )
    if patched == original:
        raise HarnessError("oneDAL clang.ref assignment patch did not match")
    compiler_file.write_text(patched, encoding="utf-8")
    (out / "onedal-clang-ref.patch").write_text(simple_output(["git", "diff", "--", str(compiler_file.relative_to(src))], cwd=src) + "\n", encoding="utf-8")
    deps_env, _ = setup_onedal_deps(work, out)
    build_work = build / "work"
    dispatcher = build_work / "oneapi/dal/_dal_cpu_dispatcher_gen.hpp"
    dispatcher.parent.mkdir(parents=True, exist_ok=True)
    dispatcher.write_text("// baseline SSE2 dispatcher: no optional AVX macros\n", encoding="utf-8")
    (out / "onedal-dispatcher-pregenerated.txt").write_text(str(dispatcher) + "\n" + dispatcher.read_text(), encoding="utf-8")
    install.mkdir(parents=True, exist_ok=True)
    build.mkdir(parents=True, exist_ok=True)
    build_env = dict(env)
    build_env.update(deps_env)
    build_env["CXXFLAGS"] = plugin_flags
    build_env["CFLAGS"] = ""
    command = [
        "bear", "--output", str(build / "compile_commands.json"), "--",
        "make", "-f", "makefile", "onedal_c", f"-j{jobs}",
        "PLAT=lnx32e", "COMPILER=clang", "BACKEND_CONFIG=ref", "OPTFLAG=O2",
        "LINKER=lld", "REQDBG=symbols", "REQCPU=sse2", "STDALLOC=yes",
        "BUILD_PARAMETERS_LIB=yes", f"WORKDIR={build_work}", f"RELEASEDIR={install}",
    ]
    run_timed(name="build", command=command, cwd=src, logs=logs, timings=timings, env=build_env, timeout=18000)


def strip_plugin_tokens(argv: list[str]) -> tuple[list[str], int]:
    out: list[str] = []
    removed = 0
    i = 0
    while i < len(argv):
        token = argv[i]
        if token.startswith("-fplugin=") and "abicheck-facts" in token:
            removed += 1; i += 1; continue
        if token == "-Xclang" and i + 1 < len(argv) and argv[i + 1] == "-plugin-arg-abicheck-facts":
            removed += 2; i += 2
            if i + 1 < len(argv) and argv[i] == "-Xclang":
                removed += 2; i += 2
            continue
        out.append(token); i += 1
    return out, removed


