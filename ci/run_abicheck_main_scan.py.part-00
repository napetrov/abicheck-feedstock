@dataclass
class CommandResult:
    name: str
    command: list[str]
    cwd: str
    started_at: str
    finished_at: str
    returncode: int
    timed_out: bool
    wall_seconds: float
    stdout: str
    stderr: str
    time_file: str
    time_metrics: dict[str, Any] = field(default_factory=dict)


class HarnessError(RuntimeError):
    pass


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat()


def sha256_file(path: Path, chunk: int = 1024 * 1024) -> str:
    h = hashlib.sha256()
    with path.open("rb") as fh:
        for data in iter(lambda: fh.read(chunk), b""):
            h.update(data)
    return h.hexdigest()


def safe_slug(value: str) -> str:
    value = re.sub(r"[^A-Za-z0-9_.-]+", "_", value)
    return value.strip("._") or "item"


def json_dump(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8", errors="replace")


def run_capture(
    argv: Sequence[str],
    *,
    cwd: Path | None = None,
    env: Mapping[str, str] | None = None,
    timeout: int = 60,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        list(argv),
        cwd=str(cwd) if cwd else None,
        env=dict(env) if env else None,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
        check=False,
    )


def parse_elapsed(value: str) -> float | None:
    try:
        pieces = value.split(":")
        if len(pieces) == 3:
            return float(pieces[0]) * 3600 + float(pieces[1]) * 60 + float(pieces[2])
        if len(pieces) == 2:
            return float(pieces[0]) * 60 + float(pieces[1])
        return float(value)
    except (TypeError, ValueError):
        return None


def parse_gnu_time(path: Path) -> dict[str, Any]:
    if not path.exists():
        return {}
    raw: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        match = TIME_RE.match(line.strip())
        if match:
            raw[match.group(1).strip()] = match.group(2).strip()
    out: dict[str, Any] = {"raw": raw}
    aliases = {
        "User time (seconds)": ("user_seconds", float),
        "System time (seconds)": ("system_seconds", float),
        "Maximum resident set size (kbytes)": ("max_rss_kib", int),
        "Minor (reclaiming a frame) page faults": ("minor_page_faults", int),
        "Major (requiring I/O) page faults": ("major_page_faults", int),
        "File system inputs": ("filesystem_inputs", int),
        "File system outputs": ("filesystem_outputs", int),
        "Voluntary context switches": ("voluntary_context_switches", int),
        "Involuntary context switches": ("involuntary_context_switches", int),
        "Exit status": ("time_exit_status", int),
    }
    for key, (dest, conv) in aliases.items():
        if key in raw:
            try:
                out[dest] = conv(raw[key])
            except ValueError:
                pass
    elapsed_key = next((k for k in raw if k.startswith("Elapsed (wall clock) time")), None)
    if elapsed_key:
        elapsed = parse_elapsed(raw[elapsed_key])
        if elapsed is not None:
            out["elapsed_seconds"] = elapsed
    if "max_rss_kib" in out:
        out["max_rss_mib"] = round(out["max_rss_kib"] / 1024.0, 3)
