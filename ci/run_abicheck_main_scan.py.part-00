#!/usr/bin/env python3
"""Build oneAPI projects with Clang and collect abicheck main L0-L5 evidence.

This is a deliberately self-contained CI harness.  It:
* builds one target from a pinned upstream ref with Clang + debug information;
* captures or generates compile_commands.json;
* inventories the entire source tree and every public header;
* runs abicheck dump with --ast-frontend clang, exact compile DB, and
  --sources/--depth source (L0-L5);
* captures GNU time -v, stdout/stderr, ELF metadata, snapshots, checksums,
  and machine-readable summaries.

The installed abicheck checkout and exact main SHA are supplied by the workflow.
"""

from __future__ import annotations

import argparse
import csv
import datetime as dt
import gzip
import hashlib
import json
import os
import platform
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Iterable, Mapping, Sequence


SOURCE_SUFFIXES = {
    ".c", ".cc", ".cpp", ".cxx", ".c++", ".m", ".mm",
    ".h", ".hh", ".hpp", ".hxx", ".inc", ".inl", ".ipp", ".tpp",
}
HEADER_SUFFIXES = {".h", ".hh", ".hpp", ".hxx", ".inc", ".inl", ".ipp", ".tpp"}
SKIP_DIR_NAMES = {
    ".git", ".github", ".cache", "__pycache__", ".pytest_cache",
    ".mypy_cache", ".ruff_cache",
}
TIME_RE = re.compile(r"^([^:]+):\s*(.*?)\s*$")
SONAME_RE = re.compile(r"\(SONAME\).*\[(.*?)\]")
BUILD_ID_RE = re.compile(r"Build ID:\s*([0-9a-fA-F]+)")


