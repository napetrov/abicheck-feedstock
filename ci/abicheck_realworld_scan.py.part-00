#!/usr/bin/env python3
"""Build and inventory a real-world C/C++ project, then run abicheck 0.3.0.

This script is intentionally evidence-preserving: every command gets raw stdout,
stderr, timing/resource data, and a machine-readable record. Full public-header
scans are attempted first. If a project's aggregate header surface cannot be
parsed as one translation unit, umbrella-header and DWARF fallbacks are retained
alongside the failed full-scan logs.
"""
from __future__ import annotations

import argparse
import csv
import datetime as dt
import gzip
import hashlib
import json
import os
